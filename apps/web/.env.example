# Copy to .env.local. These values are public and end up in the browser bundle.
VITE_NETWORK=testnet
VITE_RPC_URL=https://rpc.testnet.near.org
VITE_REGISTRY_ID=registry.nearfirewall.testnet
# Code hash of the account policy, from deployments/testnet.json. Leave empty to accept any.
VITE_POLICY_CODE_HASH=
# Set when the policy is published as a global contract (preferred: no code storage on the user's account).
VITE_POLICY_GLOBAL_CODE_HASH=
# Otherwise the app deploys this WASM to the user's account. Copy the built file into apps/web/public/.
VITE_POLICY_WASM_URL=/nearfirewall_account_policy.wasm
VITE_EXPLORER_URL=https://testnet.nearblocks.io
