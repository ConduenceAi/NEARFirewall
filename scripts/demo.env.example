# Demo accounts on NEAR Testnet. Copy to scripts/demo.env (ignored by git) and adjust.
# Keys are read from the NEAR CLI legacy keychain in ~/.near-credentials, never from this file,
# except the executor's restricted key, which the runner needs.
export NEAR_RPC_URL=https://test.rpc.fastnear.com
export NEARFIREWALL_REGISTRY=nfw-registry-1112.testnet
export NEARFIREWALL_OWNER=nfw-alice-1112.testnet
export NEARFIREWALL_EXECUTOR=nfw-runner-1112.testnet
export NEARFIREWALL_LEAF_EXECUTOR=nfw-runner1-1112.testnet
export NEARFIREWALL_VENDORS=nfw-vendor-1112.testnet,nfw-vendor2-1112.testnet,nfw-vendor3-1112.testnet
export NEARFIREWALL_AGENT=market-agent
