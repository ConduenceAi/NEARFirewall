# Proposed NEARFirewall settings. Copy to .env after implementing the backend.
# Only the following public values may be exported into the mobile bundle.
APP_ENV=development
APP_API_BASE_URL=http://localhost:8080
APP_LINK_SCHEME=nearfirewall-dev
APP_LINK_HOST=app.example.invalid
REOWN_PROJECT_ID=
OIDC_ISSUER=
OIDC_MOBILE_CLIENT_ID=
OIDC_AUDIENCE=

# Backend only. Fixture mode never calls external data or execution providers.
API_PORT=8080
DATABASE_URL=
DATA_MODE=fixture

# Chain data providers and RPCs (credential-bearing URLs are secrets).
ALCHEMY_API_KEY=
HELIUS_API_KEY=
EVM_ETHEREUM_RPC_URL=
EVM_BASE_RPC_URL=
EVM_TESTNET_RPC_URL=
SOLANA_RPC_URL=

# Allowed simulation provider: fixture, rpc or tenderly.
SIMULATION_PROVIDER=fixture
TENDERLY_ACCOUNT=
TENDERLY_PROJECT=
TENDERLY_ACCESS_KEY=
BLOCKAID_API_KEY=

# NEAR AI workspace credentials and approved model selection.
NEAR_AI_API_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_API_KEY=
NEAR_AI_MODEL=
NEAR_AI_VERIFICATION_MODE=tls

# NEAR Intents 1Click. JWT is optional for eligible quotes.
ONECLICK_API_BASE_URL=https://1click.chaindefuser.com
ONECLICK_PARTNER_JWT=

# Server flags. The initial blueprint does not enable any live signing.
FEATURE_LIVE_HANDOFF=false
FEATURE_INTENTS_EXECUTION=false
FEATURE_PUSH=false
PUSH_PROVIDER_CONFIG_REF=
